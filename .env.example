# Values prefixed with NEXT_PUBLIC_ are available in browser code.
NEXT_PUBLIC_APP_URL=

# Server-only values must never be prefixed with NEXT_PUBLIC_ or committed in .env files.
PRIVATE_API_KEY=

# Server-only Google Gemini key. Never use a NEXT_PUBLIC_ prefix.
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional local tool-failure test: set to 1 only in development. Ignored in production.
FABRIC_GUIDANCE_TEST_FAILURE=

# Optional LOCAL development fixtures only; ignored in production and on Vercel.
# See README for scenarios. Never configure these on Vercel.
ADVISOR_DEV_SCENARIO=
ADVISOR_DEV_ROUTE_ERROR=
